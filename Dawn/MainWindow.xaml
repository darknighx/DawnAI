<Window x:Class="Dawn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dawn"
        Icon="Assets/Dawn.ico"
        Width="1320"
        Height="820"
        MinWidth="1020"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#EEF4FF">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#17346B" />
        <SolidColorBrush x:Key="MutedBrush" Color="#788197" />
        <SolidColorBrush x:Key="DeepBlueBrush" Color="#183A78" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFAA62" />
        <SolidColorBrush x:Key="LavenderBrush" Color="#8E8BFF" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFB" Opacity="0.82" />
        <SolidColorBrush x:Key="GlassLineBrush" Color="#F0DCC8" />
        <SolidColorBrush x:Key="WarmTextBrush" Color="#7D5E52" />

        <LinearGradientBrush x:Key="DawnBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E9F3FF" Offset="0" />
            <GradientStop Color="#FFF7E8" Offset="0.36" />
            <GradientStop Color="#FFF1E9" Offset="0.68" />
            <GradientStop Color="#BBD4FF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFE" Offset="0" />
            <GradientStop Color="#FFF5E7" Offset="0.48" />
            <GradientStop Color="#DCE8FF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SunBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFE49A" Offset="0" />
            <GradientStop Color="#FFB16F" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WaveBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B7B5FF" Offset="0" />
            <GradientStop Color="#668DDE" Offset="0.48" />
            <GradientStop Color="#F8C5B8" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="UserBubbleBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F0EEFF" Offset="0" />
            <GradientStop Color="#E7EBFF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AssistantBubbleBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFE" Offset="0" />
            <GradientStop Color="#FFF8EF" Offset="1" />
        </LinearGradientBrush>

        <DropShadowEffect x:Key="SoftShadow" Color="#8BA2CD" BlurRadius="34" ShadowDepth="10" Opacity="0.18" />
        <DropShadowEffect x:Key="FloatShadow" Color="#B69275" BlurRadius="22" ShadowDepth="6" Opacity="0.16" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BrandText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="Foreground" Value="{StaticResource DeepBlueBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6D7890" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="InputField" TargetType="Control">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="#FFFDF8" />
            <Setter Property="BorderBrush" Value="#EEDBC9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource InputField}">
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="#FFE1BA" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="38" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource WarmTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FFB36D" />
            <Setter Property="BorderBrush" Value="#FFD4AA" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="{StaticResource DeepBlueBrush}" />
            <Setter Property="Background" Value="#FFFFFB" />
            <Setter Property="BorderBrush" Value="#F1DCC8" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="#8A7B82" />
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="BorderBrush" Value="#00FFFFFF" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,11" />
        </Style>

        <Style x:Key="ActiveNavButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="#FF9346" />
            <Setter Property="Background" Value="#FFFFFB" />
            <Setter Property="BorderBrush" Value="#F3DDC6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,11" />
        </Style>

        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="{StaticResource DeepBlueBrush}" />
            <Setter Property="Background" Value="#FBFCFF" />
            <Setter Property="BorderBrush" Value="#DADDFC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource DawnBackgroundBrush}" ClipToBounds="True">
        <Path Fill="#88D7E5FF"
              Opacity="0.62"
              Stretch="Fill"
              Data="M0,470 C140,545 185,660 360,606 C475,570 540,660 690,635 C815,615 870,535 1015,560 C1160,585 1225,690 1320,650 L1320,820 L0,820 Z" />
        <Path Fill="#8BB2CEFF"
              Opacity="0.64"
              Stretch="Fill"
              Data="M0,625 C150,560 250,610 360,655 C510,720 625,620 770,660 C940,708 1055,610 1320,598 L1320,820 L0,820 Z" />
        <Path Fill="#96FFD9B4"
              Opacity="0.36"
              Stretch="Fill"
              Data="M0,705 C160,650 285,720 450,685 C590,657 690,705 840,680 C1015,650 1160,690 1320,620 L1320,820 L0,820 Z" />
        <Ellipse Width="104" Height="104" Fill="#FFFFE8A8" Opacity="0.72" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,112" />
        <Path Stroke="#FDF7ED" StrokeThickness="1.2" Opacity="0.75" Stretch="Fill" Data="M0,590 C250,690 390,750 620,645 C810,558 1080,595 1320,505" />
        <Path Stroke="#FFFFFF" StrokeThickness="1" Opacity="0.75" Stretch="Fill" Data="M0,704 C210,620 390,722 590,690 C790,660 920,535 1320,582" />
        <Path Stroke="#FFFFFF" StrokeThickness="0.8" Opacity="0.55" Stretch="Fill" Data="M56,760 C280,664 425,735 668,694 C910,653 1055,730 1288,610" />

        <Border Margin="36,28"
                CornerRadius="34"
                Background="#AAFFFFFF"
                BorderBrush="#DAFFFFFF"
                BorderThickness="1"
                Effect="{StaticResource SoftShadow}" />

        <Grid Margin="44,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="#E9D8CB"
                    BorderThickness="1,1,0,1"
                    CornerRadius="30,0,0,30"
                    Padding="28,30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Grid Width="92" Height="70" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <Ellipse Width="46" Height="46" Fill="{StaticResource SunBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" />
                            <Path Fill="{StaticResource WaveBrush}" Stretch="Fill" Width="74" Height="24" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                  Data="M0,18 C16,0 30,0 45,12 C58,22 68,21 74,14 L74,24 L0,24 Z" />
                            <Path Fill="#F8F3FF" Opacity="0.88" Stretch="Fill" Width="72" Height="18" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                  Data="M0,16 C16,1 30,0 45,10 C57,17 66,16 72,10 L72,18 L0,18 Z" />
                        </Grid>
                        <TextBlock Text="Dawn"
                                   Style="{StaticResource BrandText}"
                                   FontSize="39"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="Your AI companion for everyday talks, big feelings, and brighter ideas."
                                   Foreground="#6E7893"
                                   FontSize="14"
                                   LineHeight="21"
                                   Width="170"
                                   Margin="0,0,0,34" />

                        <Button x:Name="NewChatButton"
                                Style="{StaticResource ActiveNavButton}"
                                Click="NewChatButton_Click"
                                Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" Foreground="#FF9346" FontSize="22" Width="30" VerticalAlignment="Center" />
                                <TextBlock Text="New Chat" Foreground="#FF9346" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="HistoryButton"
                                Style="{StaticResource NavButton}"
                                Click="HistoryButton_Click"
                                Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="H" Foreground="#A6A6B5" FontSize="15" Width="30" VerticalAlignment="Center" />
                                <TextBlock Text="History" Foreground="#8A8798" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="S" Foreground="#A6A6B5" FontSize="15" Width="30" VerticalAlignment="Center" />
                                <TextBlock Text="Settings" Foreground="#8A8798" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Background="#CCFFFFFF"
                                BorderBrush="#ECDCCA"
                                BorderThickness="1"
                                CornerRadius="22"
                                Padding="16"
                                Effect="{StaticResource FloatShadow}">
                            <StackPanel>
                                <Border Width="40" Height="40" HorizontalAlignment="Left" Background="#F4F1FF" CornerRadius="20" Margin="0,0,0,10">
                                    <TextBlock Text="*" Foreground="{StaticResource LavenderBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Dawn Studio" FontWeight="SemiBold" Foreground="{StaticResource DeepBlueBrush}" FontSize="15" />
                                <TextBlock Text="Design preview mode"
                                           Foreground="#757C94"
                                           FontSize="12"
                                           LineHeight="18"
                                           Margin="0,4,0,10" />
                                <TextBlock Text="Customize later ->" Foreground="#7777F4" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Background="#CCFFFFFF"
                                BorderBrush="#ECDCCA"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="14"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <CheckBox x:Name="DebugOllamaCheckBox"
                                          Content="Debug Ollama logs"
                                          Checked="RuntimeOption_Changed"
                                          Unchecked="RuntimeOption_Changed" />
                                <CheckBox x:Name="IncludeHistoryCheckBox"
                                          Content="Include recent chat history"
                                          IsChecked="True"
                                          Checked="RuntimeOption_Changed"
                                          Unchecked="RuntimeOption_Changed" />
                                <CheckBox x:Name="CleanVoiceTestModeCheckBox"
                                          Content="Clean voice-test mode"
                                          Checked="RuntimeOption_Changed"
                                          Unchecked="RuntimeOption_Changed" />
                                <TextBlock x:Name="SearchDiagnosticsText"
                                           Text="Search enabled: false&#x0a;Provider chain: wikipedia -> wikidata -> mediawiki&#x0a;API key: not required&#x0a;Last search attempted: no&#x0a;Last search success: false"
                                           Foreground="#757C94"
                                           FontSize="12"
                                           LineHeight="18"
                                           Margin="0,2,0,10" />
                                <Button x:Name="TestSearchButton"
                                        Content="Test Lookup"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="TestSearchButton_Click"
                                        Margin="0,0,0,8" />
                                <Button x:Name="CleanTestChatButton"
                                        Content="Reset voice test session"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="CleanTestChatButton_Click"
                                        Margin="0,4,0,8" />
                                <Button x:Name="ClearHistoryButton"
                                        Content="Delete history"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="ClearHistoryButton_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               x:Name="StatusText"
                               Text="Dawn is ready"
                               Foreground="#8991A5"
                               FontSize="12"
                               Margin="0,18,0,0" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#EFFFFAF4"
                    BorderBrush="#E9D8CB"
                    BorderThickness="1"
                    CornerRadius="0,30,30,0"
                    Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="210" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="74" Height="52" Margin="0,0,14,0">
                                <Ellipse Width="38" Height="38" Fill="{StaticResource SunBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <Path Fill="{StaticResource WaveBrush}" Stretch="Fill" Width="62" Height="20" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                      Data="M0,16 C14,1 25,1 38,10 C49,18 57,17 62,12 L62,20 L0,20 Z" />
                                <Path Fill="#FFF8FA" Opacity="0.86" Stretch="Fill" Width="60" Height="15" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7"
                                      Data="M0,13 C14,1 25,1 38,8 C49,14 56,14 60,9 L60,15 L0,15 Z" />
                            </Grid>
                            <TextBlock Text="Dawn" Style="{StaticResource BrandText}" FontSize="36" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#FAF8F3"
                                BorderBrush="#EEDFCF"
                                BorderThickness="1"
                                CornerRadius="22"
                                Padding="18,9"
                                MinWidth="178"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#77D8B7" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock x:Name="ModelStatusText"
                                           Text="AI online &amp; ready to help"
                                           Foreground="#817B85"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text=" • "
                                           Foreground="#B1A6A5"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="SearchStatusText"
                                           Text="Search: checking"
                                           Foreground="#817B85"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3"
                                Background="#FFF8F1"
                                BorderBrush="#EEDBCB"
                                BorderThickness="1"
                                CornerRadius="26"
                                Padding="10,7"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="38" Height="38" Margin="0,0,11,0">
                                    <Ellipse Stroke="#FFFFFF" StrokeThickness="3">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FFE4BF" Offset="0" />
                                                <GradientStop Color="#B8A7FF" Offset="0.48" />
                                                <GradientStop Color="#6E88D9" Offset="1" />
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="12" Height="12" Fill="#FFF2E5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Opacity="0.92" />
                                    <Path Fill="#FFF2E5"
                                          Opacity="0.88"
                                          Stretch="Fill"
                                          Width="23"
                                          Height="15"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,6"
                                          Data="M1,15 C2,7 7,2 12,2 C17,2 22,7 23,15 Z" />
                                </Grid>
                                <TextBlock Text="You"
                                           Foreground="#3D3150"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Path Stroke="#4B3B52"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M0,0 L4,4 L8,0"
                                      Width="8"
                                      Height="4"
                                      Stretch="Fill"
                                      Margin="10,2,0,0"
                                      VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="ChatPane"
                            Grid.Row="1"
                            Background="#80FFFFFF"
                            BorderBrush="#EEDCCA"
                            BorderThickness="1"
                            CornerRadius="24"
                            Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer x:Name="MessagesScroll"
                                          Grid.Row="0"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="MessagesPanel" />
                            </ScrollViewer>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <Button Style="{StaticResource ChipButton}" Margin="0,0,10,0" Content="Plan my week" />
                                <Button Style="{StaticResource ChipButton}" Margin="0,0,10,0" Content="Break down tasks" />
                                <Button Style="{StaticResource ChipButton}" Content="Find time to focus" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="HistoryPane"
                            Grid.Row="1"
                            Background="#80FFFFFF"
                            BorderBrush="#EEDCCA"
                            BorderThickness="1"
                            CornerRadius="24"
                            Padding="28"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="History"
                                               Style="{StaticResource BrandText}"
                                               FontSize="40"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Your past conversations with Dawn, saved locally."
                                               Foreground="#778197"
                                               FontSize="14" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="ClearHistoryTopButton"
                                            Content="Delete history"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="ClearHistoryButton_Click"
                                            Margin="0,0,10,0" />
                                    <Button x:Name="BackToChatButton"
                                            Content="Back to chat"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BackToChatButton_Click" />
                                </StackPanel>
                            </Grid>

                            <TextBox x:Name="HistorySearchBox"
                                     Grid.Row="1"
                                     MinHeight="42"
                                     Margin="0,0,0,18"
                                     TextChanged="HistorySearchBox_TextChanged"
                                     ToolTip="Search conversations"
                                     TextWrapping="NoWrap" />

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="HistoryListPanel" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border x:Name="InputPane"
                            Grid.Row="2"
                            Background="#FDF8F2"
                            BorderBrush="#F1D5BA"
                            BorderThickness="1"
                            CornerRadius="28"
                            Padding="16"
                            Margin="36,16,36,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="40" Height="40" CornerRadius="20" Background="#FFFBF6" BorderBrush="#F0DCCA" BorderThickness="1">
                                <TextBlock Text="+" Foreground="#9A91A5" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBox x:Name="InputBox"
                                     Grid.Column="2"
                                     MinHeight="42"
                                     MaxHeight="120"
                                     BorderThickness="0"
                                     Background="#00FFFFFF"
                                     FontSize="14"
                                     Foreground="{StaticResource InkBrush}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Center"
                                     PreviewKeyDown="InputBox_PreviewKeyDown" />

                            <Border Grid.Column="4" Width="42" Height="42" CornerRadius="21" Background="#FFFBF6" BorderBrush="#F0DCCA" BorderThickness="1">
                                <TextBlock Text="m" Foreground="#6F6776" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <Button x:Name="SendButton"
                                    Grid.Column="6"
                                    Content=">"
                                    Width="46"
                                    Height="46"
                                    Padding="0"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="SendButton_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Width="276"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,34,28"
                    Background="#EFFFFFFF"
                    BorderBrush="#ECDCCA"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="18"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Local AI model" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ModelNameBox" Text="llama3.2" MinHeight="38" Margin="0,0,0,10" />
                    <CheckBox x:Name="UseWebCheckBox" Content="Use web search when useful" IsChecked="True" />
                    <Button x:Name="CheckAiButton" Content="Check AI engine" Style="{StaticResource SecondaryButton}" Click="CheckAiButton_Click" Margin="0,0,0,10" />
                    <TextBlock Text="File workspace" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FileRootBox" MinHeight="38" Margin="0,0,0,10" />
                    <Button x:Name="OpenFileWorkspaceButton" Content="Open file folder" Style="{StaticResource SecondaryButton}" Click="OpenFileWorkspaceButton_Click" Margin="0,0,0,10" />
                    <TextBlock Text="Personal notes" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PersonalNotesBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Button x:Name="SaveProfileButton" Content="Save profile" Style="{StaticResource SecondaryButton}" Click="SaveProfileButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
