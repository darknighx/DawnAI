# Optional search settings only. No API key is required by Dawn/Ollama.
# Copy to .env in the repository root when running from that directory.
# Safe example values; no credentials or personal endpoint are included.
SEARCH_ENABLED=true
SEARCH_PROVIDER_CHAIN=wikipedia,wikidata,mediawiki,searxng
MAX_SEARCH_RESULTS=3
SEARCH_TIMEOUT_SECONDS=8
# Optional: replace with your own SearXNG base URL, or leave blank to skip it.
SEARXNG_BASE_URL=
